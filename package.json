{
  "name": "doctor-connect",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:patient": "pnpm --filter @doctor-connect/patient-app dev",
    "dev:clinic": "pnpm --filter @doctor-connect/clinic-app dev",
    "dev:admin": "pnpm --filter @doctor-connect/admin-panel dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
