# Don't let pnpm auto-satisfy workspace peerDependencies (e.g. ui-native's
# `react`/`react-native` peers) by symlinking whatever version happens to be
# highest across the monorepo (admin-panel's React 19.2.8 vs the RN apps'
# SDK-pinned 19.2.3) into that package's own node_modules — that creates a
# real version mismatch, not just a duplicate path. Each app's own declared
# version is what should resolve at runtime.
auto-install-peers=false
